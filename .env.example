FEATHERLESS_API_KEY=
HF_TOKEN=

# API (Pierre). Sem SMTP_HOST, os avisos de pendência só aparecem no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HEITOR_EMAIL_TECNICO=
HEITOR_EMAIL_RH=
# HEITOR_STUBS=1          força os stubs mesmo com o código real presente
# HEITOR_STUB_ATRASO=0.3  pausa (s) entre eventos do agente falso

# Gatilho 1: vigia da pasta. Com HEITOR_DRIVE_PASTA, observa a pasta do Drive
# (compartilhada como Leitor com a conta de serviço); senão, HEITOR_FONTE_PASTA
# (pasta local); sem nenhuma, só upload pela API.
HEITOR_DRIVE_PASTA=
HEITOR_DRIVE_CREDENCIAIS=~/.config/heitor/drive.json
HEITOR_FONTE_PASTA=
HEITOR_VIGIA_INTERVALO=10
