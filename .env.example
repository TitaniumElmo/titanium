FEATHERLESS_API_KEY=
HF_TOKEN=

# API (Pierre). Sem SMTP_HOST, os avisos de pendência só aparecem no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
HEITOR_EMAIL_TECNICO=
HEITOR_EMAIL_RH=
HEITOR_EMAIL_COORDENADOR=
# HEITOR_STUBS=1          força os stubs mesmo com o código real presente
# HEITOR_STUB_ATRASO=0.3  pausa (s) entre eventos do agente falso

# Gatilho 1: vigia da pasta. Com HEITOR_DRIVE_PASTA, observa a pasta do Drive
# (compartilhada como Leitor com a conta de serviço); senão, HEITOR_FONTE_PASTA
# (pasta local); sem nenhuma, só upload pela API.
HEITOR_DRIVE_PASTA=
HEITOR_DRIVE_CREDENCIAIS=~/.config/heitor/drive.json
HEITOR_FONTE_PASTA=
HEITOR_VIGIA_INTERVALO=10

# Nome do produto no texto dos e-mails (padrão: Heitor)
HEITOR_NOME_NO_EMAIL=

# Gatilho 2 sem vigia: intervalo (s) da cobrança de prazos vencidos
HEITOR_COBRANCA_INTERVALO=60

# Segurança do deploy público (heitor/api/seguranca.py)
# Token das rotas de administração (POST /demo/reset, POST /fontes/verificar).
# Vazio = liberadas (só na máquina de quem desenvolve). No deploy, SEMPRE preencher.
HEITOR_TOKEN_ADMIN=
# POST /demo/reset só existe com HEITOR_DEMO=1
HEITOR_DEMO=
HEITOR_MAX_UPLOAD_MB=15
HEITOR_MAX_ARQUIVOS=20
